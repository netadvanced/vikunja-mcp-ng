# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude local settings
.claude/
CLAUDE.local.md

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Per-target e2e stack credentials (docker/e2e/.env.<version>-<db>, issue #205).
# `.env` above does NOT cover these — the filenames differ — and they contain
# live API tokens for the local stacks.
docker/e2e/.env.*

# Local module-gating config (see vikunja-mcp.config.example.json)
vikunja-mcp.config.json

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Backup files (use proper git branches instead)
*.bak
*.backup
*.old
*~

# Debug
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versionstemp-coverage/

# Generated reports / process artifacts (regenerate, don't commit)
coverage_output.txt
*-report.json
.inspector-pid

# Version-matrix verdict files (npm run test:matrix) -- regenerate via a
# fresh run rather than trusting a stale committed one; see
# docs/LOCAL-TESTING.md's "Version-matrix testing" section.
e2e-verdicts/

# Agent battle-testing harness traces/verdicts (npm run battle) -- regenerate
# via a fresh run rather than committing a snapshot; see
# docs/BATTLE-TESTING.md.
battle-results/
